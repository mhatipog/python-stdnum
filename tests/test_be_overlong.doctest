>>> from stdnum.be import bis, nn, ogm_vcs, vat
>>> from stdnum.exceptions import ValidationError
>>> modules = (bis, nn, ogm_vcs, vat)
>>> def error_name(module, number):
...     try:
...         module.validate(number)
...     except ValidationError as exc:
...         return type(exc).__name__
>>> [error_name(mod, '9' * 5000) for mod in modules]
['InvalidLength', 'InvalidLength', 'InvalidLength', 'InvalidLength']
>>> [error_name(mod, '0' * 5000) for mod in modules]
['InvalidFormat', 'InvalidFormat', 'InvalidFormat', 'InvalidFormat']
>>> all(not mod.is_valid('9' * 5000) for mod in modules)
True
